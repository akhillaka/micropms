Options -MultiViews
RewriteEngine On
RewriteBase /

# ── Security: block direct access to sensitive files ────────────────────────
# Block .env file (critical — contains DB credentials)
<FilesMatch "^\.env">
    Require all denied
</FilesMatch>

# Block pms_core if it exists inside public_html (shared hosting deployments)
RewriteRule ^pms_core(/.*)?$ - [F,L]

# Module subdomains (guest/admin/assistant/saas) MUST use this same public_html
# as document root. Do not point a subdomain at public_html/admin or a new folder.

# Block debug/test scripts from being accessed directly
RewriteRule ^(debug|test_|setup_audit|add_notifications).*\.php$ - [F,L]

# Block hidden files (.git, .agents, etc.)
RewriteRule ^\.(.+) - [F,L]

# Send page URLs without .php (keep webhooks, cron, and API scripts).
RewriteCond %{THE_REQUEST} \s/+index\.php[\s?] [NC]
RewriteRule ^index\.php$ / [R=301,L,QSA]
RewriteCond %{THE_REQUEST} \s/+admin/index\.php[\s?] [NC]
RewriteRule ^admin/index\.php$ /admin [R=301,L,QSA]
RewriteCond %{THE_REQUEST} \s/+saas-admin/index\.php[\s?] [NC]
RewriteRule ^saas-admin/index\.php$ /saas-admin [R=301,L,QSA]
RewriteCond %{THE_REQUEST} \s/+(.+)\.php[\s?] [NC]
RewriteCond %{REQUEST_URI} !^/(webhook|cron|router\.php|api/|assistant/api/|admin/api/)
RewriteRule ^(.+)\.php$ /$1 [R=301,L,QSA]

# ── Routing ──────────────────────────────────────────────────────────────────
# Allow direct access to existing files and directories (css, js, images)
RewriteCond %{REQUEST_FILENAME} -f [OR]
RewriteCond %{REQUEST_FILENAME} -d
RewriteRule ^ - [L]

# Route all other requests to router.php
RewriteRule ^(.*)$ router.php [L,QSA]
