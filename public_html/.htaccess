Options -MultiViews
RewriteEngine On
RewriteBase /

# ── Security: block direct access to sensitive files ────────────────────────
# Block .env file (critical — contains DB credentials)
<FilesMatch "^\.env">
    Require all denied
</FilesMatch>

# Block pms_core if it exists inside public_html (shared hosting deployments)
RewriteRule ^pms_core(/.*)?$ - [F,L]

# Block debug/test scripts from being accessed directly
RewriteRule ^(debug|test_|setup_audit|add_notifications).*\.php$ - [F,L]

# Block hidden files (.git, .agents, etc.)
RewriteRule ^\.(.+) - [F,L]

# ── Routing ──────────────────────────────────────────────────────────────────
# Allow direct access to existing files and directories (css, js, images)
RewriteCond %{REQUEST_FILENAME} -f [OR]
RewriteCond %{REQUEST_FILENAME} -d
RewriteRule ^ - [L]

# Route all other requests to router.php
RewriteRule ^(.*)$ router.php [L,QSA]
