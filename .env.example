# Database
DB_HOST=127.0.0.1
DB_PORT=3306
DB_NAME=pms_db
DB_USER=pms_user
DB_PASS=your_strong_db_password_here
# DB_SOCKET=/tmp/mysql.sock

# Required: HMAC secret for guest portal / invoice links
INVOICE_SECRET=generate_a_long_random_string

# Razorpay (property checkout + webhooks). Never use placeholder values in production.
RAZORPAY_KEY_ID=rzp_live_xxx
RAZORPAY_KEY_SECRET=your_razorpay_secret
RAZORPAY_WEBHOOK_SECRET=your_live_webhook_secret

# WhatsApp (XpressBot / Cloud API)
WHATSAPP_TOKEN=EAAG...
WHATSAPP_PHONE_NUMBER_ID=100xxxxxxxxxxxx
WHATSAPP_WABA_ID=https://one.xpressbot.org/api/workspace/v1
WA_APP_SECRET=your_app_secret
WA_WEBHOOK_VERIFY_TOKEN=your_verify_token

# Telegram staff alerts
TELEGRAM_BOT_TOKEN=123456789:ABCdefGhIJKlmNoPQRsTUVwxyZ
TELEGRAM_CHAT_ID=-100123456789

# Telegram operations webhook (required; fail-closed if empty)
TELEGRAM_WEBHOOK_SECRET=your_telegram_webhook_secret
TELEGRAM_OPERATIONS_BOT_TOKEN=
TELEGRAM_OPERATIONS_CHAT_IDS=

# Optional SMTP. If SMTP_HOST is empty, PHP mail() is used.
# Configure SPF/DKIM/DMARC on the sending domain in DNS (not in this app).
SMTP_HOST=
SMTP_PORT=587
SMTP_USER=
SMTP_PASS=
SMTP_ENCRYPTION=tls
SMTP_FROM=no-reply@yourdomain.com

# Optional
GOOGLE_VISION_API_KEY=
GOOGLE_SHEETS_WEBHOOK_URL=
GOOGLE_SHEETS_ENABLED=false
APP_ENV=production

# GitHub token used by SaaS admin → Deploy (workflow_dispatch). Fine-grained PAT with Actions: Read and write.
GITHUB_DEPLOY_TOKEN=
GITHUB_REPO=akhillaka/micropms
GITHUB_DEPLOY_WORKFLOW=deploy-hostinger.yml
GITHUB_DEPLOY_REF=main
